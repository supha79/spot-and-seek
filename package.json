{
  "name": "spot-and-seek",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode hosted",
    "dev:local": "vite --mode development",
    "build": "tsc -b && node scripts/check-vite-env.mjs && vite build",
    "test": "node --experimental-strip-types --test tests/unit/*.test.mjs",
    "test:ui": "vitest run tests/unit/adminPersistenceWarning.test.tsx tests/unit/gameRunResults.test.tsx tests/unit/gameplayReadyModal.test.tsx tests/unit/levelAssetPairEditor.test.tsx tests/unit/playerGameplayGate.test.tsx tests/unit/layoutNavigation.test.tsx tests/unit/providerCatalogAuth.test.tsx tests/unit/authContext.test.tsx",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "26.1.0",
    "postcss": "^8.4.49",
    "supabase": "^2.120.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.4.4",
    "vitest": "^5.0.5"
  }
}
